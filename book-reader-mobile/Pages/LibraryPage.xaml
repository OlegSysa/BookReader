<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="BookReader.Mobile.Pages.LibraryPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:BookReader.Mobile.Models"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{StaticResource Paper}"
    Title="Бібліотека">

    <Grid RowDefinitions="Auto,*" Padding="20,20,20,0" RowSpacing="16">
        <VerticalStackLayout Spacing="16">
            <Grid ColumnDefinitions="*,Auto">
                <VerticalStackLayout Spacing="4">
                    <Label
                        FontAttributes="Bold"
                        FontSize="32"
                        Text="Бібліотека"
                        TextColor="{StaticResource Ink}" />
                    <Label FontSize="14" Text="4 книги" TextColor="{StaticResource Muted}" />
                </VerticalStackLayout>
                <Button
                    Grid.Column="1"
                    BackgroundColor="Transparent"
                    Clicked="OnBackClicked"
                    Text="Назад"
                    TextColor="{StaticResource Accent}"
                    VerticalOptions="Center" />
            </Grid>

            <Border
                BackgroundColor="{StaticResource Card}"
                Padding="14,4"
                Stroke="{StaticResource Line}"
                StrokeShape="RoundRectangle 12"
                StrokeThickness="1">
                <Entry Placeholder="Пошук у бібліотеці" PlaceholderColor="{StaticResource Muted}" />
            </Border>
        </VerticalStackLayout>

        <CollectionView
            Grid.Row="1"
            ItemsSource="{Binding Books}"
            SelectionMode="None">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:LibraryBookItem">
                    <Border
                        Margin="0,0,0,12"
                        BackgroundColor="{StaticResource Card}"
                        Padding="14"
                        Stroke="{StaticResource Line}"
                        StrokeShape="RoundRectangle 16"
                        StrokeThickness="1">
                        <Grid ColumnDefinitions="64,*" ColumnSpacing="14">
                            <Border
                                BackgroundColor="{Binding Cover}"
                                HeightRequest="88"
                                StrokeShape="RoundRectangle 10"
                                StrokeThickness="0"
                                WidthRequest="64">
                                <Label
                                    FontAttributes="Bold"
                                    FontSize="22"
                                    HorizontalOptions="Center"
                                    Text="{Binding Initial}"
                                    TextColor="White"
                                    VerticalOptions="Center" />
                            </Border>

                            <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                                <Label
                                    FontAttributes="Bold"
                                    FontSize="17"
                                    LineBreakMode="TailTruncation"
                                    Text="{Binding Title}"
                                    TextColor="{StaticResource Ink}" />
                                <Label
                                    FontSize="13"
                                    LineBreakMode="TailTruncation"
                                    Text="{Binding Author}"
                                    TextColor="{StaticResource Muted}" />
                                <Label
                                    Margin="0,4,0,0"
                                    FontSize="12"
                                    Text="{Binding Status}"
                                    TextColor="{StaticResource Accent}" />
                                <ProgressBar
                                    HeightRequest="4"
                                    Progress="{Binding Progress}"
                                    ProgressColor="{StaticResource Accent}" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
