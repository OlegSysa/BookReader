{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Storage": {
    "BooksPath": "..\\Storage\\RawBooks"
  },
  "MaxFileSize": 104857600,
  "BookExtensions": [
    ".pdf",
    ".epub",
    ".fb2"
  ],
  "Translation": {
    "SourceLang": "en",
    "TargetLang": "ua"
  },
  "AzureStorage": {
    "BooksContainer": "books",
    "ParsedBooksContainer": "parsed-books"
  },
  "Cache": {
    "WarmupEnabled": true,
    "Provider": "Memory"
  },
  "Messaging": {
    "Enabled": true,
    "ServiceBusEnabled": false
  },
  "Jwt": {
    "Key": "201f6fd0-d5b5-4357-8659-6a0923daa913",
    "Issuer": "BookReader",
    "Audience": "BookReader.Api",
    "ExpiresMinutes": 60
  },
  "App": {
    "BaseUrl": "http://localhost:5173"
  }
}
