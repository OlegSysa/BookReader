{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],

    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning"
      }
    },

    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/log-.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14,
          "fileSizeLimitBytes": 10485760,
          "rollOnFileSizeLimit": true
        }
      }
    ],

    "Enrich": [ "FromLogContext" ]
  },
  "AllowedHosts": "*",
  "Messaging": {
    "Enabled": true,
    "ServiceBusEnabled": false
  },
  "Jwt": {
    "Key": "201f6fd0-d5b5-4357-8659-6a0923daa913",
    "Issuer": "BookReader",
    "Audience": "BookReader.Api",
    "ExpiresMinutes": 60
  }
}
